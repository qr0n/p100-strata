From e6613e6b56eddeffbed5343a1513cbc9ba8376c2 Mon Sep 17 00:00:00 2001
From: qr0n <77075118+qr0n@users.noreply.github.com>
Date: Mon, 19 Oct 2026 02:38:02 +0000
Subject: [PATCH 3/6] serve: summary requests get at least summary_min_tokens
 of output

pi caps the history summary at 0.8 x reserveTokens and the split-turn summary at 0.5 x;
this model wrote an 11,295-token summary against a 13,107 cap. Raise (never lower) the
cap for requests matched by summary_prompt_prefixes; prepare() still clamps to context.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 serve/server.py | 35 ++++++++++++++++++++++-------------
 1 file changed, 22 insertions(+), 13 deletions(-)

diff --git a/serve/server.py b/serve/server.py
index 58fc62d6..0e8c8b6d 100644
--- a/serve/server.py
+++ b/serve/server.py
@@ -3766,6 +3766,7 @@ class Service:
         self.repeat_stop_tokens = REPEAT_STOP_TOKENS     # #606: one token this many times in a row ends a reply (0: off)
         self.summary_budget_tokens = 0                   # p100: the thinking budget for a client's summary requests
         self.summary_prefixes: tuple[str, ...] = ()      # ... recognised by the start of their system prompt
+        self.summary_min_tokens = 0                      # ... and the least output they get, whatever they asked
         self.anthropic_think_unasked = True               # #278: "anthropic_thinking": "on_request" -> False
         self.tool_call_recovery = False                   # opt-in: tool calls in forms next to the template's
         self.images = None                                # serve/images.py's ImageGen when the config has "images"
@@ -3996,21 +3997,28 @@ class Service:
             raise ValueError(f"reasoning_budget_tokens={value!r}: expected a whole number of tokens (0: no budget)")
         return value if value > 0 else None
 
-    def apply_summary_budget(self, req: dict, messages) -> None:
+    def apply_summary_budget(self, req: dict, messages, max_new: int) -> int:
         """p100: a context-compaction request (its system prompt starts with one of `summary_prefixes`) gets
         `summary_budget_tokens` as its thinking budget, unless it set its own.  Agents give the summary a fixed output
-        cap (pi: 80% of reserveTokens), and long thinking spends it before the summary is written."""
-        if not self.summary_budget_tokens or not self.summary_prefixes or req.get("reasoning_budget_tokens") is not None:
-            return
+        cap (pi: 80% of reserveTokens), and long thinking spends it before the summary is written.  The output cap is
+        raised to `summary_min_tokens` (never lowered; prepare() still clamps it to the context).  -> the cap."""
+        if not self.summary_prefixes:
+            return max_new
         first = messages[0] if messages else None
         if not isinstance(first, dict) or first.get("role") not in ("system", "developer"):
-            return
+            return max_new
         text = first.get("content")
         if isinstance(text, list):
             text = "".join(p.get("text", "") for p in text if isinstance(p, dict))
-        if isinstance(text, str) and text.lstrip().startswith(self.summary_prefixes):
+        if not (isinstance(text, str) and text.lstrip().startswith(self.summary_prefixes)):
+            return max_new
+        if self.summary_budget_tokens and req.get("reasoning_budget_tokens") is None:
             req["reasoning_budget_tokens"] = self.summary_budget_tokens
-            print(f"[strata] summary request: thinking budget {self.summary_budget_tokens} tokens", flush=True)
+        if self.summary_min_tokens and 0 < max_new < self.summary_min_tokens:
+            max_new = self.summary_min_tokens
+        print(f"[strata] summary request: thinking budget {req.get('reasoning_budget_tokens')}, "
+              f"output cap {max_new or 'rest of context'}", flush=True)
+        return max_new
 
     def _vision_down(self) -> bool:
         """The encoder should run and does not (the engine's load starts it again).  An elastic encoder is down
@@ -6961,7 +6969,7 @@ def make_handler(svc: Service):
                 tools = (tools or []) + extra or None
             if force and use_mcp:
                 raise ValueError("a forced tool_choice with MCP tools is not supported")
-            svc.apply_summary_budget(req, messages)
+            max_req = max_new = svc.apply_summary_budget(req, messages, max_new)
             svc.reasoning_budget(req)                         # a bad value is a 400 before anything is sent
             stop_strings(req)                                 # ... and so is a bad stop / stop_sequences
             check_request_sampling(req)                       # ... and a sampling field of the wrong type
@@ -7198,7 +7206,7 @@ def make_handler(svc: Service):
                 tools = None
             force = forced_call(req.get("tool_choice"), tools)        # "any" / {"type": "tool", "name": N}
             max_new = int(req.get("max_tokens") or 0)                  # 0/-1: the rest of the context
-            svc.apply_summary_budget(req, messages)
+            max_new = svc.apply_summary_budget(req, messages, max_new)
             svc.reasoning_budget(req)                         # a bad value is a 400 before anything is sent
             stop_strings(req)                                 # ... and so is a bad stop / stop_sequences
             check_request_sampling(req)                       # ... and a sampling field of the wrong type
@@ -8370,12 +8378,13 @@ def main(argv=None, *, lifecycle_event=None, interrupt_exit_code: int = 0) -> in
         raise SystemExit("[strata] config \"reasoning_loop_recovery\" must be false, \"stop\" or \"recover\", "
                          f"not {recovery!r}")
     svc.reasoning_loop_recovery = recovery
-    if cfg.get("summary_reasoning_budget_tokens"):      # p100: compaction requests only (Service.apply_summary_budget)
-        svc.summary_budget_tokens = int(cfg["summary_reasoning_budget_tokens"])
+    if cfg.get("summary_reasoning_budget_tokens") or cfg.get("summary_min_tokens"):   # p100: compaction requests only
+        svc.summary_budget_tokens = int(cfg.get("summary_reasoning_budget_tokens") or 0)
+        svc.summary_min_tokens = int(cfg.get("summary_min_tokens") or 0)
         prefixes = cfg.get("summary_prompt_prefixes") or []
         svc.summary_prefixes = tuple([prefixes] if isinstance(prefixes, str) else prefixes)
-        print(f"[strata] summary thinking budget: {svc.summary_budget_tokens} tokens for {len(svc.summary_prefixes)} "
-              f"prompt prefix(es)", flush=True)
+        print(f"[strata] summary requests: thinking budget {svc.summary_budget_tokens}, output at least "
+              f"{svc.summary_min_tokens} tokens, {len(svc.summary_prefixes)} prompt prefix(es)", flush=True)
     svc.gpu_index = (gpu_list(cfg) or [0])[0]           # the Monitor reads the card the engine runs on (issue #51)
     svc.gpu_indices = gpu_list(cfg)                     # ... or every card of a layer split (issue #112)
     if a.engine == "strata" and groups:                 # replicas: every card of every group
-- 
2.53.0

