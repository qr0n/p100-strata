From 64298257b8fc8c9acc5c945e265288671cd95147 Mon Sep 17 00:00:00 2001
From: qr0n <77075118+qr0n@users.noreply.github.com>
Date: Mon, 5 Oct 2026 06:50:21 +0000
Subject: [PATCH 1/6] p100: MXFP4 expert kernels, Q5_1 PLE rows, PLE-table
 residency fix

Needed to serve the AtomicChat Qwen3.8-Flash-Next IQ4_XS GGUF on 2x P100
(sm_60), as deployed in llama-swap qwen3.8-flash-next-strata:

- iq_kernels.cu: MXFP4 dot/dequant paths (the file's down projections).
- dequant.hpp / gguf_reader.hpp: Q5_1 block support for the PLE rows.
- ngram.{hpp,cpp} / generate.cpp: when mlock of the PLE table fails
  (8 MB memlock limit), drop the expert-shard file cache after the arena
  is pinned and re-touch the PLE table so it stays resident.

Measured (strata-bench/BENCH.log, C3): decode 37.1/37.6/37.9 tok/s,
prefill 305 (7k) / 460 (27k) tok/s.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/strata/kernels/ngram.hpp |  4 ++
 src/kernels/cuda/iq_kernels.cu   | 74 ++++++++++++++++++++++++++++++--
 src/kernels/ngram.cpp            | 25 +++++++++++
 src/program/generate.cpp         | 23 ++++++++++
 4 files changed, 122 insertions(+), 4 deletions(-)

diff --git a/include/strata/kernels/ngram.hpp b/include/strata/kernels/ngram.hpp
index 4452b4f6..c4c475e3 100644
--- a/include/strata/kernels/ngram.hpp
+++ b/include/strata/kernels/ngram.hpp
@@ -201,6 +201,10 @@ public:
     bool is_open() const;
     /// True when `PleIoOptions::lock` was asked for and the OS lock succeeded (false: pages only pre-touched).
     bool locked() const;
+    /// --ple-io ram without the lock (RLIMIT_MEMLOCK too small): fault the table's pages in again, with
+    /// `threads` readers.  A large load after open() (the expert arena, read through the same file cache) can
+    /// evict them, and every evicted row is then a random read on the request path.  Returns the seconds spent.
+    double retouch(int threads) const;
     uint64_t rows() const;
     /// "IQ4_NL" or "F8_E4M3" (a GGUF from tools/ple_fp8_pack.py: type I8, strata.ple.format = f8_e4m3).
     const char* format() const;
diff --git a/src/kernels/cuda/iq_kernels.cu b/src/kernels/cuda/iq_kernels.cu
index f39e9a95..68452225 100644
--- a/src/kernels/cuda/iq_kernels.cu
+++ b/src/kernels/cuda/iq_kernels.cu
@@ -47,6 +47,15 @@ __device__ __forceinline__ int get_int_b2(const void* x, const int& i32) {
     return x32;
 }
 __device__ __forceinline__ int get_int_b4(const void* x, const int& i32) { return ((const int*) x)[i32]; }
+// MXFP4's 17-byte blocks leave its nibbles byte-aligned only (llama.cpp's get_int_b1)
+__device__ __forceinline__ int get_int_b1(const void* x, const int& i32) {
+    const uint8_t* x8 = (const uint8_t*) x;
+    return x8[4 * i32 + 0] | (x8[4 * i32 + 1] << 8) | (x8[4 * i32 + 2] << 16) | (x8[4 * i32 + 3] << 24);
+}
+// E8M0 -> f32, llama.cpp's ggml_cuda_e8m0_to_fp32 in its pre-CUDA-12.8 form (bit-identical to the bf16raw one)
+__device__ __forceinline__ float e8m0_to_fp32(uint8_t x) {
+    return __uint_as_float(x == 0 ? 0x00400000u : (uint32_t) x << 23);
+}
 __device__ __forceinline__ uint32_t unpack_ksigns(const uint8_t v) {
     const uint32_t p = __popc(v) & 1;
     const uint32_t s = v ^ p << 7;
@@ -296,6 +305,24 @@ __device__ __forceinline__ float vec_dot_iq4_nl_q8_1(const void* __restrict__ vb
     return d * sumi;
 }
 
+// MXFP4 (AtomicChat's down projections): IQ4_NL's shape with the e2m1 codebook (doubled) and an E8M0 scale;
+// llama.cpp's vec_dot_mxfp4_q8_1
+__device__ __forceinline__ float vec_dot_mxfp4_q8_1(const void* __restrict__ vbq, const block_q8_1* __restrict__ bq8_1,
+                                                    const int& kbx, const int& iqs) {
+    const block_mxfp4* bq4 = (const block_mxfp4*) vbq + kbx;
+    const int* q8 = (const int*) bq8_1->qs + iqs;
+    int sumi = 0;
+#pragma unroll
+    for (int l = 0; l < 2; ++l) {
+        const int aux_q4 = get_int_b1(bq4->qs, iqs + l);
+        const int2 v = get_int_from_table_16(aux_q4, kvalues_mxfp4);
+        sumi = ggml_cuda_dp4a(v.x, q8[l + 0], sumi);
+        sumi = ggml_cuda_dp4a(v.y, q8[l + 4], sumi);
+    }
+    const float d = e8m0_to_fp32(bq4->e) * 0.5f * __low2float(bq8_1->ds);
+    return d * sumi;
+}
+
 // IQ4_XS: 256 values as 8 sub-blocks of 32 (6-bit scale each); one call covers one sub-block (iqs = 4 * sub-block),
 // and `bq8_1` is the super-block's first q8_1 block, so the call's activation is bq8_1[iqs / 4].  The GSQ-RCO IQ3_S
 // file keeps one layer's routed gate/up experts in this format.
@@ -727,6 +754,8 @@ template<> struct Fmt<18> { static constexpr int qk = 256, ipb = 8, step = 2;
     __device__ static float dot(const void* v, const block_q8_1* y, int kbx, int iqs) { return vec_dot_iq3_xxs_q8_1(v, y, kbx, iqs); } };
 template<> struct Fmt<20> { static constexpr int qk = 32, ipb = 2, step = 2;
     __device__ static float dot(const void* v, const block_q8_1* y, int kbx, int iqs) { return vec_dot_iq4_nl_q8_1(v, y, kbx, iqs); } };
+template<> struct Fmt<39> { static constexpr int qk = 32, ipb = 2, step = 2;
+    __device__ static float dot(const void* v, const block_q8_1* y, int kbx, int iqs) { return vec_dot_mxfp4_q8_1(v, y, kbx, iqs); } };
 template<> struct Fmt<21> { static constexpr int qk = 256, ipb = 8, step = 2;
     __device__ static float dot(const void* v, const block_q8_1* y, int kbx, int iqs) { return vec_dot_iq3_s_q8_1(v, y, kbx, iqs); } };
 template<> struct Fmt<23> { static constexpr int qk = 256, ipb = 8, step = 4;
@@ -770,11 +799,11 @@ template<> struct Fmt<146> { static constexpr int qk = 128, ipb = 8, step = 4;
 #endif
 // Q5_K / Q6_K downs: Qwen3.6-35B-A3B (FF 512, whole 256-blocks per row); Flash-Next's FF 640 never selects them
 #ifdef STRATA_Q6K_EXPERTS
-#define STRATA_D_FMTS(X) X(20) X(23) X(42) X(7) X(6) X(2) X(3) X(8) X(13) X(14) X(40) X(144) X(146)
+#define STRATA_D_FMTS(X) X(20) X(39) X(23) X(42) X(7) X(6) X(2) X(3) X(8) X(13) X(14) X(40) X(144) X(146)
 #else
-#define STRATA_D_FMTS(X) X(20) X(23) X(42) X(7) X(6) X(2) X(3) X(8) X(13) X(40) X(144) X(146)
+#define STRATA_D_FMTS(X) X(20) X(39) X(23) X(42) X(7) X(6) X(2) X(3) X(8) X(13) X(40) X(144) X(146)
 #endif
-#define STRATA_MMVQ_FMTS(X) X(16) X(17) X(18) X(20) X(21) X(22) X(23) X(29) X(42) X(12) X(13) X(7) X(6) X(2) X(3) X(8) X(40) X(144) X(145) X(146)
+#define STRATA_MMVQ_FMTS(X) X(16) X(17) X(18) X(20) X(39) X(21) X(22) X(23) X(29) X(42) X(12) X(13) X(7) X(6) X(2) X(3) X(8) X(40) X(144) X(145) X(146)
 template<> struct Fmt<40> { static constexpr int qk = 64, ipb = 2, step = 4;     // NVFP4: 2 calls of 32 values
     __device__ static float dot(const void* v, const block_q8_1* y, int kbx, int iqs) { return vec_dot_nvfp4_q8_1(v, y, kbx, iqs); } };
 
@@ -1138,6 +1167,29 @@ template<> struct Split<20> {   // IQ4_NL
         return d * sumi;
     }
 };
+template<> inline constexpr bool kSplit<39> = true;
+template<> struct Split<39> {   // MXFP4: Split<20> with byte-aligned nibbles, the e2m1 table and the E8M0 scale
+    struct W { int2 v[2]; float dw; };
+    __device__ static W load(const void* __restrict__ vbq, int kbx, int iqs) {
+        const block_mxfp4* bq4 = (const block_mxfp4*) vbq + kbx;
+        W r;
+#pragma unroll
+        for (int l = 0; l < 2; ++l) r.v[l] = get_int_from_table_16(get_int_b1(bq4->qs, iqs + l), kvalues_mxfp4);
+        r.dw = e8m0_to_fp32(bq4->e) * 0.5f;
+        return r;
+    }
+    __device__ static float apply(const W& r, const block_q8_1* __restrict__ bq8_1, int iqs) {
+        const int* q8 = (const int*) bq8_1->qs + iqs;
+        int sumi = 0;
+#pragma unroll
+        for (int l = 0; l < 2; ++l) {
+            sumi = ggml_cuda_dp4a(r.v[l].x, q8[l + 0], sumi);
+            sumi = ggml_cuda_dp4a(r.v[l].y, q8[l + 4], sumi);
+        }
+        const float d = r.dw * __low2float(bq8_1->ds);
+        return d * sumi;
+    }
+};
 template<> inline constexpr bool kSplit<23> = true;
 template<> struct Split<23> {   // IQ4_XS
     struct W { int2 v[4]; int ls; float dw; };
@@ -2932,6 +2984,18 @@ __device__ void dq_iq4_nl(const void* vx, int64_t ibs, dst_t* yy, int tid) {
         y[j + 16] = cvt<dst_t>(d * kvalues_iq4nl[q4[j] >> 4]);
     }
 }
+template<typename dst_t>
+__device__ void dq_mxfp4(const void* vx, int64_t ibs, dst_t* yy, int tid) {   // llama.cpp's dequantize_mxfp4
+    const block_mxfp4* x = (const block_mxfp4*) vx + ibs * (QK_K / QK_MXFP4);
+    const int64_t il = tid / 8, ib = tid % 8;
+    dst_t* y = yy + 32 * ib + 4 * il;
+    const uint8_t* q4 = x[ib].qs + 4 * il;
+    const float d = e8m0_to_fp32(x[ib].e);
+    for (int j = 0; j < 4; ++j) {
+        y[j + 0] = cvt<dst_t>(d * kvalues_mxfp4[q4[j] & 0xf] * 0.5f);
+        y[j + 16] = cvt<dst_t>(d * kvalues_mxfp4[q4[j] >> 4] * 0.5f);
+    }
+}
 // Q3_K (the Q2_0 file's token_embd): llama.cpp's dequantize_block_q3_K, its 64 threads folded onto 32
 template<typename dst_t>
 __device__ void dq_q3_k(const void* vx, int64_t ibs, dst_t* yy, int tid) {
@@ -3179,6 +3243,7 @@ __device__ __forceinline__ void dq_dispatch(int ty, const void* vx, int64_t ibs,
         case 17: dq_iq2_xs(vx, ibs, y, tid); break;
         case 18: dq_iq3_xxs(vx, ibs, y, tid); break;
         case 20: dq_iq4_nl(vx, ibs, y, tid); break;
+        case 39: dq_mxfp4(vx, ibs, y, tid); break;
         case 21: dq_iq3_s(vx, ibs, y, tid); break;
         case 22: dq_iq2_s(vx, ibs, y, tid); break;
         case 29: dq_iq1_m(vx, ibs, y, tid); break;
@@ -3237,7 +3302,7 @@ __global__ void dequant_gu_kernel(int ty, const void* __restrict__ gate, const v
 
 // the types dq_dispatch dequantizes
 bool is_iq(int t) {
-    return t == 16 || t == 17 || t == 18 || t == 20 || t == 21 || t == 22 || t == 23 || t == 29 || t == 42 || t == 11 ||
+    return t == 16 || t == 17 || t == 18 || t == 20 || t == 39 || t == 21 || t == 22 || t == 23 || t == 29 || t == 42 || t == 11 ||
 #ifdef STRATA_Q6K_EXPERTS
            t == 12 || t == 13 || t == 14 || t == 7 || t == 6 || t == 2 || t == 3 || t == 8 || t == 40 || t == 144 || t == 145 || t == 146;
 #else
@@ -4183,6 +4248,7 @@ size_t iq_row_bytes(int t, int64_t n) noexcept {
         case 17: return (size_t) (n / 256) * sizeof(block_iq2_xs);
         case 18: return (size_t) (n / 256) * sizeof(block_iq3_xxs);
         case 20: return (size_t) (n / 32) * sizeof(block_iq4_nl);
+        case 39: return (size_t) (n / 32) * sizeof(block_mxfp4);
         case 21: return (size_t) (n / 256) * sizeof(block_iq3_s);
         case 22: return (size_t) (n / 256) * sizeof(block_iq2_s);
         case 29: return (size_t) (n / 256) * sizeof(block_iq1_m);
diff --git a/src/kernels/ngram.cpp b/src/kernels/ngram.cpp
index 07636d0f..9b1166a9 100644
--- a/src/kernels/ngram.cpp
+++ b/src/kernels/ngram.cpp
@@ -11,6 +11,7 @@
 #include <cerrno>
 #include <cmath>
 #include <cstdio>
+#include <chrono>
 #include <cstring>
 #include <limits>
 #if !defined(_WIN32)
@@ -466,6 +467,30 @@ void PleTable::close() {
 
 bool PleTable::is_open() const { return impl_->data != nullptr || impl_->reader.is_open(); }
 bool PleTable::locked() const { return impl_->locked; }
+double PleTable::retouch(int threads) const {
+#if defined(_WIN32)
+    (void) threads;
+    return 0.0;
+#else
+    if (impl_->locked || impl_->data == nullptr || impl_->mode != PleIo::Mmap) return 0.0;
+    const auto t0 = std::chrono::steady_clock::now();
+    const uint64_t page = 4096, need = impl_->n_rows * (uint64_t) impl_->rb;
+    const uintptr_t a0 = (uintptr_t) impl_->data & ~(uintptr_t) (page - 1), a1 = (uintptr_t) impl_->data + need;
+    madvise((void*) a0, a1 - a0, MADV_WILLNEED);
+    const int nt = std::max(1, threads);
+    const uintptr_t span = ((a1 - a0) / (uintptr_t) nt + page - 1) & ~(uintptr_t) (page - 1);
+    std::vector<std::thread> th;
+    for (int t = 0; t < nt; ++t)
+        th.emplace_back([=] {
+            volatile uint8_t sink = 0;
+            for (uintptr_t p = a0 + (uintptr_t) t * span; p < std::min(a1, a0 + (uintptr_t) (t + 1) * span); p += page)
+                sink = sink + *(const volatile uint8_t*) p;
+            (void) sink;
+        });
+    for (auto& x : th) x.join();
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+#endif
+}
 const char* PleTable::format() const { return impl_->fmt->name; }
 PleIo PleTable::mode() const { return impl_->mode; }
 uint64_t PleTable::rows() const { return impl_->n_rows; }
