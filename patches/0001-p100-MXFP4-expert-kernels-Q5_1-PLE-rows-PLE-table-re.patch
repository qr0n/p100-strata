index dbc0cf83..2b1d5bd9 100644
--- a/src/program/generate.cpp
+++ b/src/program/generate.cpp
@@ -135,6 +135,10 @@ namespace strata::metal_engine { void set_model_shard(const char* shard1); }   /
 #include <cmath>
 #include <limits>
 #include <cstdio>
+#if !defined(_WIN32)
+#include <fcntl.h>
+#include <unistd.h>
+#endif
 #include <cstdlib>
 #include <cstring>
 #include <filesystem>
@@ -5833,6 +5837,25 @@ int main(int argc, char** argv) {
         std::fprintf(stderr, "strata generate: loaded %.2f GiB at %.2f GiB/s\n",
                      (double) strata::kernels::cpu::expert_layout().total / (1024.0 * 1024 * 1024),
                      arena_src.load_gib_per_second());
+#if !defined(_WIN32)
+        // The arena is now a pinned copy: the file-cache pages its read left behind are dead weight, and on a PC whose
+        // RAM holds the arena and the --ple-io ram table with little to spare (90 GB here) they evict the table when
+        // its mlock failed.  Drop them from every shard except the table's, then fault the table back in.
+        // STRATA_KEEP_EXPERT_CACHE=1 skips this (the A/B arm).
+        if (!o.native_preset.empty() && std::getenv("STRATA_KEEP_EXPERT_CACHE") == nullptr) {
+            int dropped = 0;
+            for (const std::string& path : strata::gguf_split_paths(o.native_preset)) {
+                if (path == o.ple_gguf) continue;
+                const int fd = ::open(path.c_str(), O_RDONLY);
+                if (fd < 0) continue;
+                if (posix_fadvise(fd, 0, 0, POSIX_FADV_DONTNEED) == 0) ++dropped;
+                ::close(fd);
+            }
+            const double rt = ple_table.retouch(16);
+            std::fprintf(stderr, "strata generate: dropped the file cache of %d expert shard(s); PLE table re-touched "
+                                 "in %.1f s%s\n", dropped, rt, ple_table.locked() ? " (locked: skipped)" : "");
+        }
+#endif
         // A rate under ~0.2 GiB/s is not the hardware.  Task Scheduler / service contexts throttle this
         // read+fill about 24x (measured 0.05 vs 1.42 GiB/s for the same binary, args and cache state; the
         // scheduler's defaults - Below normal priority and a least-privilege token - were the only
