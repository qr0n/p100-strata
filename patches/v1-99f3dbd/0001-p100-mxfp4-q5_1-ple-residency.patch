 include/strata/artifact/dequant.hpp     | 16 ++++++
 include/strata/artifact/gguf_reader.hpp |  4 ++
 include/strata/kernels/ngram.hpp        |  4 ++
 src/kernels/cuda/iq_kernels.cu          | 72 +++++++++++++++++++++++--
