index 298dc3b..7aa35bd 100644
--- a/include/strata/artifact/gguf_reader.hpp
+++ b/include/strata/artifact/gguf_reader.hpp
@@ -146,6 +146,10 @@ inline bool block_geometry(uint32_t t, int& elems, int& bytes) {
         elems = 32;
         bytes = 24;
         return true;
+    case 39:   // MXFP4: E8M0 scale + 16 nibble bytes
+        elems = 32;
+        bytes = 17;
+        return true;
     case 8:
         elems = 32;
         bytes = 34;
