From 88d1a002a664a0bb7762f8ba607f42e4a9fe0215 Mon Sep 17 00:00:00 2001
From: qr0n <77075118+qr0n@users.noreply.github.com>
Date: Tue, 27 Oct 2026 02:52:59 +0000
Subject: [PATCH 6/6] p100: MXFP4 down on the 8-lane K=640 rows, aligned
 get_int_b1, VABSDIFF4 activation byte sums

- native_down_multi_kernel: MXFP4 (39) takes the IQ4_NL 8-lane row path (same 32-value, 2-int block shape),
  with the matching 32-rows-per-block grid. nvprof decode: 1.57 s -> 0.71 s.
- get_int_b1: one aligned word (+1 when straddling) and a PRMT instead of four byte loads.
- dp4a_ones: dp4a(u, 0x01010101, c) as one VABSDIFF4 on sm_60 (0 mismatches over 4.2M pairs).
Atomic pack, 2x P100, with STRATA_Q8_SM60=1 --layer-split 25 --trim-stage-weights: bench decode
44.5/45.1/44.0 (production) -> 62.3/58.2/60.0; gate passes (QUALITY.log g27-c9b).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernels/cuda/iq_kernels.cu | 44 ++++++++++++++++++++++++----------
 1 file changed, 31 insertions(+), 13 deletions(-)

diff --git a/src/kernels/cuda/iq_kernels.cu b/src/kernels/cuda/iq_kernels.cu
index c77d6061..8149521b 100644
--- a/src/kernels/cuda/iq_kernels.cu
+++ b/src/kernels/cuda/iq_kernels.cu
@@ -47,10 +47,28 @@ __device__ __forceinline__ int get_int_b2(const void* x, const int& i32) {
     return x32;
 }
 __device__ __forceinline__ int get_int_b4(const void* x, const int& i32) { return ((const int*) x)[i32]; }
+// c + the sum of u's four signed bytes, i.e. dp4a(u, 0x01010101, c).  sm_60 has no dp4a and emulates it with four
+// VMADs; one VABSDIFF4 (|byte - 0| summed, native on GP100) of the bytes biased to unsigned gives the same int
+// (0 mismatches over 4.2M random pairs and the edge bytes), the -512 removing the bias of 128 per byte.
+__device__ __forceinline__ int dp4a_ones(int u, int c) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 610
+    unsigned r;
+    asm("vabsdiff4.u32.u32.u32.add %0, %1, %2, %3;" : "=r"(r) : "r"(u ^ 0x80808080), "r"(0), "r"(c - 512));
+    return (int) r;
+#else
+    return STRATA_DP4A(u, 0x01010101, c);
+#endif
+}
 // MXFP4's 17-byte blocks leave its nibbles byte-aligned only (llama.cpp's get_int_b1)
+// GP100 is issue-bound here: four byte loads, three shifts and three ORs per int measured ~130 GB/s for the MXFP4
+// down rows.  One aligned word (two when the int straddles a word) and one PRMT give the same int.
 __device__ __forceinline__ int get_int_b1(const void* x, const int& i32) {
-    const uint8_t* x8 = (const uint8_t*) x;
-    return x8[4 * i32 + 0] | (x8[4 * i32 + 1] << 8) | (x8[4 * i32 + 2] << 16) | (x8[4 * i32 + 3] << 24);
+    const uintptr_t a = (uintptr_t) x + 4 * (uintptr_t) i32;
+    const uint32_t* w = (const uint32_t*) (a & ~(uintptr_t) 3);
+    const uint32_t sh = (uint32_t) (a & 3);
+    const uint32_t lo = __ldg(w);
+    if (sh == 0) return (int) lo;
+    return (int) __byte_perm(lo, __ldg(w + 1), 0x3210u + sh * 0x1111u);
 }
 // E8M0 -> f32, llama.cpp's ggml_cuda_e8m0_to_fp32 in its pre-CUDA-12.8 form (bit-identical to the bf16raw one)
 __device__ __forceinline__ float e8m0_to_fp32(uint8_t x) {
@@ -275,8 +293,8 @@ __device__ __forceinline__ float vec_dot_iq1_m_q8_1(const void* __restrict__ vbq
         sumi[l0 / 4] = ggml_cuda_dp4a(grid1, u1, sumi[l0 / 4]);
         const float delta = -1.0f + IQ1M_DELTA - (qhl & 0x08) * (2.0f * IQ1M_DELTA / 0x08);
         int sumy = 0;
-        sumy = ggml_cuda_dp4a(u0, 0x01010101, sumy);
-        sumy = ggml_cuda_dp4a(u1, 0x01010101, sumy);
+        sumy = dp4a_ones(u0, sumy);
+        sumy = dp4a_ones(u1, sumy);
         sumf[l0 / 4] += delta * sumy;
     }
     const uint16_t* sc = (const uint16_t*) bq1->scales;
@@ -361,7 +379,7 @@ __device__ __forceinline__ float vec_dot_q4_K_q8_1_impl_vmmq(const int* __restri
         const int v0i = (v[0] >> (4 * i)) & 0x0F0F0F0F;
         const int v1i = (v[1] >> (4 * i)) & 0x0F0F0F0F;
         const int dot1 = ggml_cuda_dp4a(v1i, u[2 * i + 1], ggml_cuda_dp4a(v0i, u[2 * i + 0], 0));
-        const int dot2 = ggml_cuda_dp4a(0x01010101, u[2 * i + 1], ggml_cuda_dp4a(0x01010101, u[2 * i + 0], 0));
+        const int dot2 = dp4a_ones(u[2 * i + 1], dp4a_ones(u[2 * i + 0], 0));
         sumf_d += d8[i] * (dot1 * sc[i]);
         sumf_m += d8[i] * (dot2 * m[i]);   // the min times the sum of the QUANTIZED activations
     }
@@ -383,7 +401,7 @@ __device__ __forceinline__ float vec_dot_q5_K_q8_1_impl_vmmq(const int* __restri
         const int v0i = vl0i | vh0i;
         const int v1i = vl1i | vh1i;
         const int dot1 = ggml_cuda_dp4a(v0i, u[2 * i + 0], ggml_cuda_dp4a(v1i, u[2 * i + 1], 0));
-        const int dot2 = ggml_cuda_dp4a(0x01010101, u[2 * i + 0], ggml_cuda_dp4a(0x01010101, u[2 * i + 1], 0));
+        const int dot2 = dp4a_ones(u[2 * i + 0], dp4a_ones(u[2 * i + 1], 0));
         sumf_d += d8[i] * (dot1 * sc[i]);
         sumf_m += d8[i] * (dot2 * m[i]);
     }
@@ -525,7 +543,7 @@ __device__ __forceinline__ float vec_dot_q4_1_q8_1(const void* __restrict__ vbq,
         const int u0 = get_int_b4(bq8_1->qs, iqs + i), u1 = get_int_b4(bq8_1->qs, iqs + i + QI4_1);
         sumi = ggml_cuda_dp4a((v >> 0) & 0x0F0F0F0F, u0, sumi);
         sumi = ggml_cuda_dp4a((v >> 4) & 0x0F0F0F0F, u1, sumi);
-        sumu = ggml_cuda_dp4a(0x01010101, u1, ggml_cuda_dp4a(0x01010101, u0, sumu));
+        sumu = dp4a_ones(u1, dp4a_ones(u0, sumu));
     }
     const float2 dm4 = __half22float2(bq4_1->dm);
     const float d8 = __low2float(bq8_1->ds);
@@ -552,7 +570,7 @@ __device__ __forceinline__ float vec_dot_q5_1_q8_1(const void* __restrict__ vbq,
         vi1 |= (vh << 2) & 0x00100000;
         vi1 |= (vh << 9) & 0x10000000;
         sumi = ggml_cuda_dp4a(vi1, u1, sumi);
-        sumu = ggml_cuda_dp4a(0x01010101, u1, ggml_cuda_dp4a(0x01010101, u0, sumu));
+        sumu = dp4a_ones(u1, dp4a_ones(u0, sumu));
     }
     const float2 dm5 = __half22float2(bq5_1->dm);
     const float d8 = __low2float(bq8_1->ds);
@@ -1125,8 +1143,8 @@ template<> struct Split<29> {   // IQ1_M
             sumi[l0 / 4] = ggml_cuda_dp4a(r.g[l0 + 0], u0, sumi[l0 / 4]);
             sumi[l0 / 4] = ggml_cuda_dp4a(r.g[l0 + 1], u1, sumi[l0 / 4]);
             int sumy = 0;
-            sumy = ggml_cuda_dp4a(u0, 0x01010101, sumy);
-            sumy = ggml_cuda_dp4a(u1, 0x01010101, sumy);
+            sumy = dp4a_ones(u0, sumy);
+            sumy = dp4a_ones(u1, sumy);
             sumf[l0 / 4] += r.delta[l0 / 2] * sumy;
         }
         const float d = r.dw * __low2float(bq8_1[iqs].ds);
@@ -1365,7 +1383,7 @@ template<> struct S27<7> {   // Q5_1
             vi1 |= (vh << 2) & 0x00100000;
             vi1 |= (vh << 9) & 0x10000000;
             sumi = ggml_cuda_dp4a(vi1, u1, sumi);
-            sumu = ggml_cuda_dp4a(0x01010101, u1, ggml_cuda_dp4a(0x01010101, u0, sumu));
+            sumu = dp4a_ones(u1, dp4a_ones(u0, sumu));
         }
         const float2 dm5 = __half22float2(r.dm);
         const float d8 = __low2float(bq8_1->ds);
@@ -2251,7 +2269,7 @@ __global__ void __launch_bounds__(256) native_down_multi_kernel(const unsigned l
             return;
         }
     } else
-    if constexpr (SUB_DOWN && (TD == 20 || TD == 40)) {   // IQ4_NL (K 40) and NVFP4 (K 20): 8-lane rows
+    if constexpr (SUB_DOWN && (TD == 20 || TD == 39 || TD == 40)) {   // IQ4_NL and MXFP4 (K 40), NVFP4 (K 20): 8-lane rows
         if (hb == 20) {
             const int r = blockIdx.x * 32 + (threadIdx.x >> 3);
             const int t = threadIdx.x & 7;
@@ -5308,7 +5326,7 @@ void native_expert_grouped(const NativeExpertLayout& L, const unsigned long long
     }
     if (g_exp_phase == 1) return;
     const bool tq_sub8 = (L.d_type == 144 || L.d_type == 146) && !g_old_kernels && !g_no_sub16_gu && L.n_ff == 640 && (tq_stage_on() || tq_sub8_on());   // the trellis down rows as 8-lane rows
-    const int d_rows = (!g_old_kernels && !g_no_sub16_gu && L.n_ff == 640) ? (L.d_type == 20 || L.d_type == 40 || tq_sub8 ? 32 : (L.d_type == 42 ? 16 : 8)) : 8;
+    const int d_rows = (!g_old_kernels && !g_no_sub16_gu && L.n_ff == 640) ? (L.d_type == 20 || L.d_type == 39 || L.d_type == 40 || tq_sub8 ? 32 : (L.d_type == 42 ? 16 : 8)) : 8;
     const int tq_ch = tq_sub8 ? tq_row_chunks() : 1;   // the staged trellis down kernel takes this many 32-row chunks a block
     const dim3 gd((unsigned) (((L.n_embd + d_rows - 1) / d_rows + tq_ch - 1) / tq_ch), (unsigned) gy);
 #if STRATA_EXP_LAYOUTS
